# Configuración del Servidor
PORT=3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=countries_db
POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=tu_contraseña

# MongoDB
MONGODB_URI=mongodb://localhost:27017/countries_db

# ============================================
# SUPABASE (PostgreSQL en la Nube)
# ============================================
SUPABASE_CONNECTION_STRING=postgresql://postgres.xxxxx:tu_password@db.xxxxx.supabase.co:5432/postgres

SUPABASE_HOST=db. xxxxx.supabase.co
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres.xxxxx
SUPABASE_PASSWORD=tu_password_de_supabase

# Alternar entre BD local y nube
USE_SUPABASE=false